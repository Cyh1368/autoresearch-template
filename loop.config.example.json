{
  "strong_model": {
    "provider": "openrouter",
    "model": "openai/gpt-6-sol",
    "api_key_env": "OPENROUTER_API_KEY",
    "base_url": "https://openrouter.ai/api/v1"
  },
  "agent": {
    "argv": ["your-agent", "--prompt-file", "{prompt_file}"],
    "prompt_via": "file",
    "timeout_minutes": null
  },
  "git": {
    "enabled": true,
    "remote": "origin"
  },
  "stop": {
    "stale_window": 3,
    "max_cycles": null
  }
}
