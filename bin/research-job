#!/usr/bin/env python3
import sys,pathlib
sys.path.insert(0,str(pathlib.Path(__file__).resolve().parents[1]))
from core.runner import run_job
if len(sys.argv)<4: raise SystemExit('usage: research-job {local|slurm} POLICY.json COMMAND [ARGS...]')
try: raise SystemExit(run_job(sys.argv[1:]))
except (ValueError,KeyError) as e: raise SystemExit(str(e))
